<?xml version="1.0" ?>
<sdf version="1.6">
  <include>
      <uri>model://sun</uri>
    </include>
  
  <world name="tennis_court_world">
    
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="court_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="front_c"><pose>12 0 0.5 0 0 0</pose><geometry><box><size>0.005 11 1</size></box></geometry></collision>
        <visual name="front_v"><pose>12 0 0.5 0 0 0</pose><geometry><box><size>0.005 11 1</size></box></geometry><material><ambient>0 0.5 0 0.3</ambient><diffuse>0 0.5 0 0.3</diffuse></material></visual>
        
        <collision name="back_c"><pose>-12 0 0.5 0 0 0</pose><geometry><box><size>0.005 11 1</size></box></geometry></collision>
        <visual name="back_v"><pose>-12 0 0.5 0 0 0</pose><geometry><box><size>0.005 11 1</size></box></geometry><material><ambient>0 0.5 0 0.3</ambient><diffuse>0 0.5 0 0.3</diffuse></material></visual>
        
        <collision name="left_c"><pose>0 5.5 0.5 0 0 0</pose><geometry><box><size>24 0.005 1</size></box></geometry></collision>
