<?xml version="1.0"?>
<robot name="tennis_bot">

  <!-- 註解方式 -->
  <link name="base_link">
  </link>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="front_chassis"/>
    <origin xyz="0 0 0.02" rpy="0 0 -1.5708"/>  
  </joint>
  <joint name="base_to_rear" type="fixed">
    <parent link="base_link"/>
    <child link="rear_basket"/>
    <origin xyz="0 -0.01 0" rpy="0 0 -1.5708"/> 
  </joint>
  
  <!-- 前車體 -->
  <link name="front_chassis">
    <visual>
      <geometry>
        <mesh filename="package://tennis_bot/urdf/meshes/front_chassis.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  
  <!-- 後車體 -->
  <link name="rear_basket">
    <visual>
      <geometry>
        <mesh filename="package://tennis_bot/urdf/meshes/rear_basket.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://tennis_bot/urdf/meshes/rear_basket.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.05" ixy="0.05" ixz="0.05" iyy="0.05" iyz="0.05" izz="0.05"/>
    </inertial>
  </link>

  <!-- 左滾輪 -->
  <link name="left_roller">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="blue"><color rgba="0.8 0.8 0 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/> <geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <!-- 撿球改用物理滾輪：恢復碰撞 (原始版本就是半徑0.045)，海綿壓縮用下面 gazebo reference 的 kp/kd -->
    <collision>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="left_roller_joint" type="continuous">
    <parent link="front_chassis"/>
    <child link="left_roller"/>
    <!--origin xyz="0.065 0.15 0.03" rpy="-0.785398 0 0"/-->
    <!-- 滾輪位置用 tennis_bot/record (5/13) 驗證成功、影片 47.webm 同款的 (y=0.2, z=0.03)。
         CAD 位置 (0.102322, 0.045104) 離後車廂 17.7cm 前擋牆只有 10cm，球被推到牆邊
         只能垂直彈起、永遠進不了車廂 (experiments/roller_pickup 實測)。 -->
    <origin xyz="0.065 0.2 0.03" rpy="-0.785398 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 右滾輪 -->
  <link name="right_roller">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="blue"><color rgba="0.8 0.8 0 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/> <geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <!-- 撿球改用物理滾輪：恢復碰撞 (原始版本就是半徑0.045)，海綿壓縮用下面 gazebo reference 的 kp/kd -->
    <collision>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="right_roller_joint" type="continuous">
    <parent link="front_chassis"/>
    <child link="right_roller"/>
    <!--origin xyz="0.205 0.15 0.03" rpy="-0.785398 0 0"/-->
    <origin xyz="0.205 0.2 0.03" rpy="-0.785398 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 左驅動輪 -->
  <link name="left_drive_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="front_chassis"/>
    <child link="left_drive_wheel"/>
    <origin xyz="-0.01 0.08 0.02" rpy="0 1.5708 0"/>
    <axis xyz="0 0 -1"/> 
  </joint>

  <!-- 右驅動輪 -->
  <link name="right_drive_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="front_chassis"/>
    <child link="right_drive_wheel"/>
    <origin xyz="0.28 0.08 0.02" rpy="0 1.5708 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- 後車體左萬象輪 -->
  <link name="rear_left_caster">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.015"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="rear_left_caster_joint" type="fixed">
    <parent link="rear_basket"/>
    <child link="rear_left_caster"/>
    <origin xyz="0.028 -0.349 0.015" rpy="0 0 0"/>
  </joint>

  <!-- 後車體右萬象輪 -->
  <link name="rear_right_caster">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.015"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="rear_right_caster_joint" type="fixed">
    <parent link="rear_basket"/>
    <child link="rear_right_caster"/>
    <origin xyz="0.222 -0.349 0.015" rpy="0 0 0"/>
  </joint>



  <!-- gazebo 滾輪 -->
  <gazebo reference="left_roller">
    <material>Gazebo/Blue</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>150</kp>
    <kd>4.2</kd>
    <min_depth>0.001</min_depth>
    <max_vel>10</max_vel>
  </gazebo>
  <gazebo reference="right_roller">
    <material>Gazebo/Blue</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>150</kp>
    <kd>4.2</kd>
    <min_depth>0.001</min_depth>
    <max_vel>10</max_vel>
  </gazebo>
  
    <gazebo>
    <plugin name="roller_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=roller_cmd</remapping>
        <remapping>odom:=roller_odom_dump</remapping>
      </ros>
      <left_joint>left_roller_joint</left_joint>
      <right_joint>right_roller_joint</right_joint>
      <wheel_separation>0.14</wheel_separation>
      <wheel_diameter>0.09</wheel_diameter>
      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <!-- 100 Hz：馬達模型 (motor_driver_node) 用這個封包時間戳當 10 ms 時鐘，跟 STM32 TIM6 同頻率 -->
      <update_rate>100</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>left_roller_joint</joint_name>
      <joint_name>right_roller_joint</joint_name>
    </plugin>
  </gazebo>


  <!-- gazebo 驅動倫 -->
  <gazebo reference="left_drive_wheel">
    <mu1>200.0</mu1>
    <mu2>200.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_drive_wheel">
    <mu1>200.0</mu1>
    <mu2>200.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- 0.29 = 模擬車左右驅動輪的真實距離 (原本寫 0.27，車體實際轉速只有指令的 0.27/0.29=93%)。
           加速度不在這裡限制 (0 = 不限制)：底盤加減速改由 motor_driver_node 的 STM32 PID + 馬達模型決定。 -->
      <wheel_separation>0.29</wheel_separation>
      <wheel_diameter>0.08</wheel_diameter>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>0.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo> 

<link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.03"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
</link>

<joint name="camera_joint" type="fixed">
    <parent link="front_chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.135 0.1 0.13" rpy="0 0 1.5708"/> 
</joint>

<gazebo reference="camera_link">
    <sensor type="camera" name="tennis_camera">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/image_raw:=tennis_camera/image_raw</remapping>
        </ros>
        <camera_name>tennis_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 陀螺儀 (IMU)：直接量測車體真實角速度，不經過輪子，不受打滑影響。
       模擬真實化 R4：加上雜訊 + 零點偏移 (原本沒有 <noise> = 完美無誤差)，對應實體車 BNO080：
       - 白雜訊：BNO080 沒公開陀螺儀雜訊密度，用同家族 BMI055 規格 0.014 °/s/√Hz，
         1000Hz 取樣每筆標準差 = 0.014*√1000 = 0.44 °/s = 0.0077 rad/s
       - 零點偏移：BNO080 規格書 Game Rotation Vector 航向漂移 0.5 °/min = 1.45e-4 rad/s，
         當作校正後殘留的偏移 (Gazebo 每次開機隨機抽一個偏移值，正負號隨機)
       base_link 完全是空的 (沒有 inertial)，感測器直接掛上去 Gazebo 沒有正確
       產生 /imu topic，所以跟 camera_link 一樣另外開一個小 link 掛感測器。 -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 -0.135 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0077</stddev><bias_mean>0.000145</bias_mean><bias_stddev>0.00005</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0077</stddev><bias_mean>0.000145</bias_mean><bias_stddev>0.00005</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0077</stddev><bias_mean>0.000145</bias_mean><bias_stddev>0.00005</bias_stddev></noise></z>
        </angular_velocity>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
