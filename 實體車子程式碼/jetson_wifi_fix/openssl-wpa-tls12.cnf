# wpa_supplicant 2.6 不懂 TLS 1.3 的 EAP 金鑰算法，跟清大 RADIUS 協商成 TLS 1.3 時會「PMKID mismatch」被斷線。
# 只給 wpa_supplicant 用（透過 systemd drop-in 設 OPENSSL_CONF），不影響系統其他程式。
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MaxProtocol = TLSv1.2
